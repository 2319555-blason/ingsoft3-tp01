# PLANTILLA de variables de entorno. Este archivo SÍ se versiona,
# porque no tiene secretos reales: solo documenta qué hay que definir.
#
# Para levantar el sistema: copiá este archivo a .env y poné valores
# propios. El .env real NO se versiona (está en .gitignore), porque
# subir credenciales a un repo público es un incidente de seguridad:
# quedan para siempre en el historial de git aunque después las borres.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_una_password_propia
POSTGRES_DB=app
