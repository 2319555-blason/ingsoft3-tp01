# Dependencias instaladas localmente: se reinstalan adentro del
# contenedor con npm ci. Copiarlas sería lento y podría traer binarios
# compilados para Windows que no sirven en Linux.
node_modules/

# Resultado de un build local: el build bueno se hace adentro.
dist/

# Reporte de cobertura generado en tu máquina (TP5)
coverage/

# Pruebas de integración/e2e (TP7): corren en el pipeline contra QA, no van adentro de la imagen
e2e/
playwright.config.js
playwright-report/
test-results/

# Historial de git, config del editor y del propio Docker
.git
.vscode/
Dockerfile
.dockerignore

# Logs y secretos
npm-debug.log*
.env
.env.local
